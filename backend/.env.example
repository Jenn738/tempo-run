# Spotify: https://developer.spotify.com/dashboard -> your app -> Client ID
SPOTIFY_CLIENT_ID=

# Strava: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Where the frontend runs (Strava login sends you back here when it's done)
FRONTEND_URL=http://127.0.0.1:5173
# Where this backend runs (used to build the Strava callback URL)
BACKEND_URL=http://127.0.0.1:8000

# Optional: Discord webhook for Spotify access requests from friends
# (Discord channel -> Edit channel -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=
